{
  "packageVersion": "0.1.0",
  "patterns": {
    "P1": {
      "context": {
        "deterministic_checks": {
          "check_hard": true
        },
        "forbidden": {
          "check_hard": [
            "ELIGIBLE"
          ]
        },
        "provided_ids": [
          "a",
          "b",
          "c"
        ],
        "verdict_set": [
          "ELIGIBLE",
          "INELIGIBLE"
        ]
      },
      "output": {
        "band": "MEDIUM",
        "cited_ids": [
          "a",
          "b"
        ],
        "digest": "x",
        "verdict": "ELIGIBLE"
      }
    },
    "P2": {
      "context": {
        "rules": {
          "has_pricing": {
            "kind": "bool"
          },
          "heading_count": {
            "delta": 1,
            "kind": "int_abs"
          },
          "plan": {
            "allowed": [
              "FREE",
              "PRO",
              "ENTERPRISE"
            ],
            "kind": "enum"
          },
          "word_bucket": {
            "edges": [
              300,
              1000
            ],
            "kind": "bucket"
          }
        }
      },
      "output": {
        "facts": {
          "has_pricing": true,
          "heading_count": 4,
          "plan": "PRO",
          "word_bucket": 500
        },
        "source_status": "OK"
      }
    },
    "P3": {
      "context": {
        "max": 1000,
        "min": 0,
        "mode": "bps",
        "tolerance_bps": 100,
        "unit_set": [
          "USD",
          "EUR"
        ]
      },
      "output": {
        "unit": "USD",
        "value": 500
      }
    },
    "P4": {
      "context": {
        "candidates": [
          "a",
          "b",
          "c",
          "d",
          "e"
        ],
        "k": 3,
        "max_rank_distance": 1,
        "min_overlap_pct": 66
      },
      "output": {
        "ranking": [
          "a",
          "b",
          "c",
          "d"
        ]
      }
    },
    "P5": {
      "context": {
        "mode": "set_equal"
      },
      "output": {
        "entities": [
          "alpha",
          "beta"
        ]
      }
    },
    "P6": {
      "context": {
        "allow_unavailable": true,
        "evidence_ids": [
          "e1",
          "e2",
          "e3"
        ]
      },
      "output": {
        "answer": true,
        "evidence_ids": [
          "e1",
          "e2"
        ],
        "source_status": "OK"
      }
    }
  }
}
