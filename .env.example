# Copy to `.env` for local runs. Never commit a real `.env`.

# StudioNet is gasless: 0 GEN is expected and no private key is required to deploy there.
# This file intentionally contains no key. Testnet (Bradbury / Asimov) needs a funded
# account; claim testnet GEN at https://testnet-faucet.genlayer.foundation/ (browser only).

# RPC endpoints are selected with `genlayer network set` for built-in networks. Do not
# override RPC URLs manually.

# Optional: LLM provider configuration, only if your own validators use a custom provider.
# GL_LLM_PROVIDER=
# GL_LLM_API_KEY=
