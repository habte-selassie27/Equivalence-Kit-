{
  "packageVersion": "0.1.0",
  "patterns": [
    {
      "canonicalContext": {
        "deterministic_checks": {
          "check_hard": true
        },
        "forbidden": {
          "check_hard": [
            "ELIGIBLE"
          ]
        },
        "provided_ids": [
          "a",
          "b",
          "c"
        ],
        "verdict_set": [
          "ELIGIBLE",
          "INELIGIBLE"
        ]
      },
      "failureBehavior": "LLM_ERROR with a reason code; state unchanged.",
      "fields": [
        {
          "comparator": "enum_equal",
          "compared": true,
          "explanation": "normalize_enum then enum_equal",
          "name": "verdict",
          "normalizer": "normalize_enum"
        },
        {
          "comparator": "ordinal_within(1)",
          "compared": true,
          "explanation": "normalize_enum then ordinal_within(1)",
          "name": "band",
          "normalizer": "normalize_enum"
        },
        {
          "comparator": "subset_of(universe)",
          "compared": true,
          "explanation": "normalize_id_list then subset_of(universe)",
          "name": "cited_ids",
          "normalizer": "normalize_id_list"
        },
        {
          "comparator": "none",
          "compared": false,
          "explanation": "Stored for humans; never compared in consensus.",
          "name": "digest",
          "normalizer": "clip_text"
        }
      ],
      "id": "P1",
      "invariants": [
        "consistent_with(verdict, deterministic_checks, forbidden)"
      ],
      "knownLimits": [
        "Cannot detect a consistently wrong verdict shared by every validator."
      ],
      "name": "Verdict plus band",
      "paramVariants": {
        "deterministic_checks": [
          {
            "check_hard": true
          },
          {
            "check_hard": false
          }
        ],
        "provided_ids": [
          [
            "a",
            "b",
            "c"
          ],
          [
            "a"
          ],
          [
            "a",
            "b"
          ]
        ]
      },
      "params": {
        "deterministic_checks": [
          {
            "check_hard": true
          },
          {
            "check_hard": false
          }
        ],
        "forbidden": {
          "check_hard": [
            "ELIGIBLE"
          ]
        },
        "provided_ids": [
          "a",
          "b",
          "c"
        ],
        "verdict_set": [
          "ELIGIBLE",
          "INELIGIBLE"
        ]
      },
      "toleranceRationale": "Models disagree on confidence more than on the decision; one band step absorbs that without allowing a decision flip.",
      "useWhen": "A judgment comes with confidence: eligibility, compliance, support.",
      "whyNotStrictEq": "One band step and id ordering vary honestly between validators; digest prose always differs."
    },
    {
      "canonicalContext": {
        "rules": {
          "has_pricing": {
            "kind": "bool"
          },
          "heading_count": {
            "delta": 1,
            "kind": "int_abs"
          },
          "plan": {
            "allowed": [
              "FREE",
              "PRO",
              "ENTERPRISE"
            ],
            "kind": "enum"
          },
          "word_bucket": {
            "edges": [
              300,
              1000
            ],
            "kind": "bucket"
          }
        }
      },
      "failureBehavior": "EXTERNAL with SOURCE_UNREACHABLE; downstream treats it as insufficient evidence, never a negative finding.",
      "fields": [
        {
          "comparator": "enum_equal",
          "compared": true,
          "explanation": "normalize_enum then enum_equal",
          "name": "source_status",
          "normalizer": "normalize_enum"
        },
        {
          "comparator": "facts_match(rules)",
          "compared": true,
          "explanation": "per-fact then facts_match(rules)",
          "name": "facts",
          "normalizer": "per-fact"
        }
      ],
      "id": "P2",
      "invariants": [
        "UNAVAILABLE implies no fact values"
      ],
      "knownLimits": [
