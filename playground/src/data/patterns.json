              "delta": 1,
              "kind": "int_abs"
            },
            "plan": {
              "allowed": [
                "FREE",
                "PRO",
                "ENTERPRISE"
              ],
              "kind": "enum"
            },
            "word_bucket": {
              "edges": [
                300,
                1000
              ],
              "kind": "bucket"
            }
          },
          {
            "has_pricing": {
              "kind": "bool"
            }
          }
        ]
      },
      "toleranceRationale": "Counts and dates are bucketed; headings use normalized keys and a documented alias table.",
      "useWhen": "Extracting a fixed set of structured facts from a web page or API.",
      "whyNotStrictEq": "Page markup, heading case, counts and fetch order vary between validators."
    },
    {
      "canonicalContext": {
        "max": 1000,
        "min": 0,
        "mode": "bps",
        "tolerance_bps": 100,
        "unit_set": [
          "USD",
          "EUR"
        ]
      },
      "failureBehavior": "LLM_ERROR OUT_OF_RANGE or WRONG_TYPE; state unchanged.",
      "fields": [
        {
          "comparator": "enum_equal",
          "compared": true,
          "explanation": "normalize_enum then enum_equal",
          "name": "unit",
          "normalizer": "normalize_enum"
        },
        {
          "comparator": "int_within_abs or int_within_bps",
          "compared": true,
          "explanation": "normalize_int then int_within_abs or int_within_bps",
          "name": "value",
          "normalizer": "normalize_int"
        }
      ],
      "id": "P3",
      "invariants": [
        "value inside [min, max]",
        "zero handled explicitly"
      ],
      "knownLimits": [
        "A biased source that shifts every validator is not detected."
      ],
      "name": "Bounded number",
      "paramVariants": {
        "mode": [
          "bps",
          "abs"
        ],
        "tolerance_bps": [
          100,
          10000
        ]
      },
      "params": {
        "delta": 5,
        "max": 1000,
        "min": 0,
        "mode": [
          "abs",
          "bps"
        ],
        "tolerance_bps": [
          100,
          10000
        ],
        "unit_set": [
          "EUR",
          "USD"
        ]
      },
      "toleranceRationale": "Tolerance comes from observed variation and is recorded as integer basis points.",
      "useWhen": "A score, count, price or measurement has natural noise.",
      "whyNotStrictEq": "Independent measurement and model runs differ by small integer amounts."
    },
    {
